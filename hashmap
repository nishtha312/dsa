class Solution:
    def isIsomorphic(self, m: str, n: str) -> bool:
        d = {}
        t = {}

        for i in range(len(m)):
            if m[i] not in d:
                d[m[i]] = i
            if n[i] not in t:
                t[n[i]] = i
            if d[m[i]] != t[n[i]]:
                return False
        return True

    
