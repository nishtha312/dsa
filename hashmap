class Solution:
    def containsDuplicate(self, nums: List[int]) -> bool:
        
        d = {}
        for i in nums:
            if i in d.keys():
                d[i] += 1
            else:
                d[i] = 1
            if d[i] > 1:
                return True
        return False
        
