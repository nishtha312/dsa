class Solution:
    def wordPattern(self, pattern: str, s: str) -> bool:
        s = s.split()
        print(s[0])
        d = {}
        t = {}
        if len(pattern) != len(s):
            return False
        for i in range(len(s)):
            if s[i] not in d:
                d[s[i]] = i
            if pattern[i] not in t:
                t[pattern[i]] = i
            if d[s[i]] != t[pattern[i]]:
                return False
